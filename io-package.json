{
  "common": {
    "name": "spaceweather",
    "version": "0.0.1",
    "title": "SpaceWeather Adapter",
    "authors": ["Herr Gott <noreply@example.com>"],
    "desc": "Lädt aktuelle Solarwind- und Magnetfeld-Daten von NOAA",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "enabled": true,
    "loglevel": "info",
    "license": "MIT",
    "keywords": ["space", "solar wind", "magnetosphere"],
    "type": "weather",
    "connectionType": "none",
    "dataSource": "poll",
    "materialize": true,
    "compact": true
  },
  "native": {},
  "objects": [],
  "instanceObjects": [
    {
      "_id": "solarwind",
      "type": "channel",
      "common": { "name": "Solarwind-Daten" },
      "native": {}
    },
    {
      "_id": "magnetosphere",
      "type": "channel",
      "common": { "name": "Magnetfeld-Daten" },
      "native": {}
    }
  ]
}

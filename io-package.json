{
  "common": {
    "name": "spaceweather",
    "version": "1.0.0",
    "title": "Space Weather and Geodata",
    "desc": {
      "en": "Space weather, solar wind, Kp-index and earthquake data from NOAA and USGS",
      "de": "Weltraumwetter-, Solarwind-, Kp-Index- und Erdbebendaten von NOAA und USGS"
    },
    "platforms": [
      "Javascript/Node.js"
    ],
    "node": ">=18.0.0",
    "mode": "daemon",
    "loglevel": "info",
    "type": "weather",
    "license": "MIT",
    "installedFrom": "https://github.com/hanebuechenes/spaceweather.git",
    "authors": [
      "Cyrano Etzler <hanebuechenes>"
    ],
    "connectionType": "cloud",
    "dataSource": "poll"
  },
  "native": {
    "pollingInterval": 5
  },
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": { "name": "Adapter Information" },
      "native": {}
    },
    {
      "_id": "info.last_update",
      "type": "state",
      "common": {
        "name": "Last Data Timestamp",
        "type": "string",
        "role": "value.datetime",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "solarwind",
      "type": "channel",
      "common": { "name": "Solar Wind Data" },
      "native": {}
    },
    {
      "_id": "solarwind.speed",
      "type": "state",
      "common": { "name": "Solar Wind Speed", "type": "number", "role": "value.speed", "unit": "km/s", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "solarwind.density",
      "type": "state",
      "common": { "name": "Solar Wind Density", "type": "number", "role": "value", "unit": "cm^-3", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "solarwind.temperature",
      "type": "state",
      "common": { "name": "Solar Wind Temperature", "type": "number", "role": "value.temperature", "unit": "K", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "solarwind.proton_flux",
      "type": "state",
      "common": { "name": "Proton Flux", "type": "number", "role": "value", "unit": "pfu", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "magnetosphere",
      "type": "channel",
      "common": { "name": "Magnetosphere Data" },
      "native": {}
    },
    {
      "_id": "magnetosphere.bx",
      "type": "state",
      "common": { "name": "Magnetic Field Bx", "type": "number", "role": "value.magnetic", "unit": "nT", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "magnetosphere.by",
      "type": "state",
      "common": { "name": "Magnetic Field By", "type": "number", "role": "value.magnetic", "unit": "nT", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "magnetosphere.bz",
      "type": "state",
      "common": { "name": "Magnetic Field Bz", "type": "number", "role": "value.magnetic", "unit": "nT", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "magnetosphere.bt",
      "type": "state",
      "common": { "name": "Magnetic Field Bt", "type": "number", "role": "value.magnetic", "unit": "nT", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "electric_field",
      "type": "channel",
      "common": { "name": "Elektrisches Feld Daten" },
      "native": {}
    },
    {
      "_id": "electric_field.e_field",
      "type": "state",
      "common": { "name": "Electric Field (E-Field)", "type": "number", "role": "value.electricField", "unit": "mV/m", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "geomagnetic_disturbance",
      "type": "channel",
      "common": { "name": "Geomagnetische Störung" },
      "native": {}
    },
    {
      "_id": "geomagnetic_disturbance.dst_index",
      "type": "state",
      "common": { "name": "Dst Index", "type": "number", "role": "value.warning", "unit": "nT", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "geomagnetic_disturbance.g_storm_risk",
      "type": "state",
      "common": { "name": "Geomagnetic Storm Risk", "type": "string", "role": "indicator.text", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "kp_index",
      "type": "channel",
      "common": { "name": "Planetary K-Index Daten" },
      "native": {}
    },
    {
      "_id": "kp_index.value",
      "type": "state",
      "common": { "name": "Planetary K-Index (Kp)", "type": "number", "role": "value", "unit": "", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "kp_index.a_running",
      "type": "state",
      "common": { "name": "Kp Running A-Index", "type": "number", "role": "value", "unit": "", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "kp_index.station_count",
      "type": "state",
      "common": { "name": "Number of Stations", "type": "number", "role": "value", "unit": "", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "solar_activity",
      "type": "channel",
      "common": { "name": "Sonnenaktivität" },
      "native": {}
    },
    {
      "_id": "solar_activity.f107_radio_flux",
      "type": "state",
      "common": { "name": "F10.7 Radio Flux", "type": "number", "role": "value", "unit": "sfu", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "solar_activity.sunspot_number",
      "type": "state",
      "common": { "name": "Sunspot Number", "type": "number", "role": "value", "unit": "", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "solar_activity.xray_flux",
      "type": "state",
      "common": { "name": "GOES X-Ray Flux", "type": "number", "role": "value", "unit": "W/m^2", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "solar_activity.m_flare_prob",
      "type": "state",
      "common": { "name": "M-Class Flare Probability", "type": "number", "role": "value.forecast", "unit": "%", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "solar_activity.x_flare_prob",
      "type": "state",
      "common": { "name": "X-Class Flare Probability", "type": "number", "role": "value.forecast", "unit": "%", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "earthquake",
      "type": "channel",
      "common": { "name": "Erdbeben-Daten (USGS)" },
      "native": {}
    },
    {
      "_id": "earthquake.magnitude",
      "type": "state",
      "common": { "name": "Latest Magnitude", "type": "number", "role": "value.warning", "unit": "M", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "earthquake.place",
      "type": "state",
      "common": { "name": "Latest Location", "type": "string", "role": "text", "read": true, "write": false },
      "native": {}
    },
    {
      "_id": "earthquake.time",
      "type": "state",
      "common": { "name": "Latest Timestamp", "type": "string", "role": "value.datetime", "read": true, "write": false },
      "native": {}
    }
  ],
  "objects": []
}